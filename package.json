{
  "name": "@fystash_ai/convex",
  "description": "Fystash Convex component — multi-agent rooms (create, spawn, drive, exec, destroy) from Convex actions.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fystash/convex-component.git"
  },
  "homepage": "https://github.com/fystash/convex-component#readme",
  "bugs": {
    "url": "https://github.com/fystash/convex-component/issues"
  },
  "version": "0.1.3",
  "license": "Apache-2.0",
  "keywords": [
    "convex",
    "component",
    "fystash",
    "sandbox",
    "multi-agent",
    "ai",
    "agents"
  ],
  "type": "module",
  "scripts": {
    "build": "tsc --project ./tsconfig.build.json",
    "build:codegen": "npx convex codegen --component-dir ./src/component && npm run build",
    "build:clean": "rm -rf dist *.tsbuildinfo && npm run build:codegen",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "prepare": "npm run build",
    "example": "vite --config example/vite.config.ts --clearScreen false",
    "example:build": "vite build --config example/vite.config.ts"
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/client/index.d.ts",
      "default": "./dist/client/index.js"
    },
    "./test": "./src/test.ts",
    "./_generated/component.js": {
      "types": "./dist/component/_generated/component.d.ts"
    },
    "./convex.config": {
      "types": "./dist/component/convex.config.d.ts",
      "default": "./dist/component/convex.config.js"
    },
    "./convex.config.js": {
      "types": "./dist/component/convex.config.d.ts",
      "default": "./dist/component/convex.config.js"
    }
  },
  "peerDependencies": {
    "convex": "^1.24.8"
  },
  "dependencies": {
    "@fystash_ai/sdk": "^0.1.3"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "convex": "^1.25.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4",
    "@vitejs/plugin-react": "^4.3.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^6.0.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1"
  },
  "types": "./dist/client/index.d.ts",
  "module": "./dist/client/index.js"
}
